# =============================================================================
# Multi-Agent Options Trading Research System - environment template
# Copy to .env and fill in. NEVER commit .env.
# The system runs end-to-end with ZERO credentials using mock providers.
# =============================================================================

# --- Core ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json

# SQLite by default. For Postgres:
#   postgresql+psycopg://matb:matb@localhost:5432/matb
DATABASE_URL=sqlite:///./data/matb.db

# --- Safety (do not change unless you know what you are doing) -----------
# Order execution is not implemented. This flag exists so that any future
# execution module is fail-closed by default.
ENABLE_ORDER_EXECUTION=false

# --- LLM -----------------------------------------------------------------
# Backend: scripted | anthropic
#   scripted  = deterministic offline stand-in, no credentials needed
#   anthropic = real Claude calls (requires ANTHROPIC_API_KEY)
LLM_BACKEND=scripted
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120

# --- Provider backends: mock | rest | mcp --------------------------------
FMP_BACKEND=mock
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

UNUSUAL_WHALES_BACKEND=mock
UNUSUAL_WHALES_API_KEY=
UNUSUAL_WHALES_BASE_URL=https://api.unusualwhales.com

# Robinhood is used for executable-market validation ONLY (chains/quotes).
# No order endpoints are implemented in this codebase.
ROBINHOOD_BACKEND=mock
ROBINHOOD_MCP_ENDPOINT=

NEWS_BACKEND=mock
NEWS_API_KEY=

# --- Provider behaviour ---------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=2

# --- Determinism ----------------------------------------------------------
# Seed used by mock providers so scans are reproducible.
MOCK_SEED=20240101

# --- Methodology ----------------------------------------------------------
METHODOLOGY_CONFIG_PATH=config/methodology.yaml
